{
  "name": "@memoracompany/orbis",
  "version": "0.1.0",
  "description": "Orbis by Memora — The Web, Working for You. Agent-native, ultra-lightweight headless browser engine with CDP, W3C WebDriver, semantic AXTree distillation, and built-in stealth",
  "homepage": "https://orbis.memora.company",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orbis": "./dist/cli/index.js",
    "memora-orbis": "./dist/cli/index.js",
    "memora-browser": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALLATION.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:tsc": "tsc",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "test": "tsx tests/benchmark.ts",
    "benchmark": "tsx tests/benchmark.ts",
    "benchmark:chrome": "tsx tests/compare-chrome.ts",
    "test:robots": "tsx tests/test-robots.ts",
    "test:proxy": "tsx tests/test-proxy.ts",
    "test:selenium": "tsx tests/test-selenium.ts",
    "test:scripts": "tsx tests/test-scripts.ts",
    "test:agents": "tsx tests/test-agent-features.ts",
    "test:all": "npm run benchmark && npm run test:proxy && npm run test:selenium && npm run test:robots && npm run test:scripts && npm run test:agents"
  },
  "keywords": [
    "orbis",
    "memora",
    "headless-browser",
    "cdp",
    "ai-agents",
    "web-scraping",
    "llm",
    "playwright",
    "puppeteer",
    "stealth",
    "selenium",
    "webdriver",
    "proxy"
  ],
  "author": "Memora (https://memora.company)",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "commander": "^13.1.0",
    "css-select": "^5.1.0",
    "esbuild": "^0.25.0",
    "parse5": "^7.2.1",
    "playwright-core": "^1.64.1",
    "undici": "^7.30.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/ws": "^8.5.14",
    "javascript-obfuscator": "^5.9.0",
    "selenium-webdriver": "^4.51.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yadavmandeep/orbis.git"
  }
}
